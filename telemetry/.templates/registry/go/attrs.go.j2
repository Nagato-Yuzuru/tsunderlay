{#- Renders attrs.go from the v2 context of the registry in telemetry/. -#}
{%- set semconv_base = "https://opentelemetry.io/schemas/" -%}
{%- set semconv = ctx.registry.attribute_groups | selectattr("id", "eq", "tsunderlay.semconv") | first -%}
{%- macro value_consts(attr, members) -%}

// Values of {{ attr.annotations.go.name }}.
const (
{%- for m in members %}
{%- if not loop.first %}
{% endif %}
	// {{ m.brief | trim }}
	{{ m.annotations.go.name }} = "{{ m.value }}"
{%- endfor %}
)
{%- endmacro -%}
// Code generated by weaver from telemetry/. DO NOT EDIT.

//go:build darwin

package main

{% for dep in ctx.dependency_graph[ctx.schema_url] if dep.startswith(semconv_base) -%}
import semconv "go.opentelemetry.io/otel/semconv/v{{ dep[semconv_base | length:] }}"
{%- endfor %}

// Log attribute keys. A key is a contract with the queries of the operator:
// do not rename one. docs/telemetry.md describes each key.
const (
{%- for attr in ctx.registry.attributes %}
{%- if not loop.first %}
{% endif %}
	// {{ attr.brief | trim }}
	{{ attr.annotations.go.name }} = "{{ attr.key }}"
{%- endfor %}
{%- for attr in semconv.attributes %}

	// {{ attr.brief | trim }}
	{{ attr.annotations.go.name }} = string(semconv.{{ attr.key | pascal_case }}Key)
{%- endfor %}
)
{%- for attr in ctx.registry.attributes if attr.type.members is defined %}

{{ value_consts(attr, attr.type.members) }}
{%- endfor %}
{%- for attr in semconv.attributes if attr.annotations.go.members is defined %}

{{ value_consts(attr, attr.annotations.go.members) }}
{%- endfor %}
